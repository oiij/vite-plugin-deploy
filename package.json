{
  "name": "@oiij/vite-plugin-deploy",
  "type": "module",
  "version": "0.0.4",
  "description": "A Vite plugin for deploying static files use ssh2-sftp-client",
  "author": "oiij",
  "license": "MIT",
  "homepage": "https://github.com/oiij/vite-plugin-deploy",
  "repository": {
    "type": "git",
    "url": "git@github.com:oiij/vite-plugin-deploy.git"
  },
  "bugs": "https://github.com/oiij/vite-plugin-deploy/issues",
  "keywords": [
    "vite-plugin-deploy",
    "ssh2-sftp-client"
  ],
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "LICENSE",
    "README.md",
    "dist",
    "package.json"
  ],
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsc --noEmit && tsdown",
    "start": "pnpx esno src/index.ts",
    "test": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type:check": "tsc --noEmit",
    "release": "pnpx bumpp && npm publish",
    "awe": "pnpx are-we-esm",
    "nmi": "pnpx node-modules-inspector",
    "update:deps": "pnpx taze -w && pnpm i",
    "cz": "czg",
    "commit": "git pull && git add -A && pnpm cz && git push",
    "prepublishOnly": "pnpm build",
    "preinstall": "npx only-allow pnpm",
    "postinstall": "pnpm simple-git-hooks"
  },
  "peerDependencies": {
    "vite": "^7.0.4"
  },
  "dependencies": {
    "@types/ssh2-sftp-client": "^9.0.6",
    "ora": "^9.1.0",
    "ssh2-sftp-client": "^12.0.1",
    "tar": "^7.5.22"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.2.0",
    "@oiij/tsconfig": "^0.0.4",
    "@types/node": "^26.1.2",
    "@vitest/ui": "^4.1.10",
    "commitlint": "^21.2.1",
    "cz-git": "^1.13.1",
    "czg": "^1.13.1",
    "eslint": "^10.8.0",
    "lint-staged": "^17.3.0",
    "simple-git-hooks": "^2.13.1",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged && pnpm type:check"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "pnpm lint:fix"
    ]
  },
  "publishConfig": {
    "access": "public"
  }
}
